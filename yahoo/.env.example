# Copy to .env and fill in, or let `uv run yahoo-login` write it for you.
# Never commit the real .env -- it holds live OAuth credentials. (Already gitignored.)

# From your Yahoo app at https://developer.yahoo.com/apps/ (Confidential Client,
# Fantasy Sports: Read/Write, redirect URI https://localhost:8000)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=

# Written automatically by `yahoo-login`; only set by hand if bridging tokens manually.
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=

# Optional: your default league key (e.g. 449.l.365083), so tools can omit league_key.
# Find it with the list_leagues tool after your first successful login.
YAHOO_LEAGUE_KEY=
